<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bapat Invoice</title>
  <base href="<%= data.base %>" />
  <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            margin: 0;
            padding: 0;
            background: #fff;
            color: #000;
        }

        .container {
            width: 800px;
            margin: auto;
            border: 1px solid #ccc;
            padding: 15px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }

        .logo_img {
            width: 180px;
            height: 100%;
        }

       .main_heading {
            text-align: center;
            margin: 10px 0;
            font-weight: 800;
            text-decoration: underline;
        }

        .company-details {
            text-align: right;
            margin-top: 5px;
        }



        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        table,
        th,
        td {
            border: 1px solid #000;
        }

        th,
        td {
            padding: 6px;
            text-align: left;
        }

        .text-right {
            text-align: right;
        }

        .no-border {
            border: none;
        }

        .summary {
            margin-top: 10px;
            border: 1px solid #000;
            padding: 10px;
            text-align: center;
            font-weight: bold;
        }

        .prescription {
            margin-top: 20px;
        }

        .footer-note {
            font-size: 12px;
            margin-top: 15px;
        }

        .checkbox {
            margin-top: 8px;
        }

        .margin-top-zero {
            margin-top: 0px;
        }

        .padding_zero {
            padding: 0px;
        }

        .total_submmary {
            text-align: right;
        }

        .total_submmary p {
            font-size: 15px;
            color: #000;
            font-weight: 800;
            margin: 0px;
        }

        .total_submmary h4 {
            font-size: 20px;
            color: #000;
            font-weight: 800;
            margin: 0px;
        }

        .bg_td {
            background: #ddd;
        }

        .title_txt_two {
            text-align: left;
        }

        .text-center {
            text-align: center;
        }

        .table_bold_text {
            text-align: center;
            font-weight: 800;
            font-size: 15px;
        }

        .margin_top {
            margin-top: 10px;
        }

        .bapat_heading {
            margin: 0px;
            font-size: 20px;
            font-weight: 800;
        }
    </style>
</head>

<body>
  <div class="container">

    <div class="header">
      <table class="no-border padding_zero">
        <tr class="no-border">
          <td width="50%" class="no-border"><img  src="<%= data?.app_setup?.logo %>" alt="logo" class="logo_img"></td>
          <td width="50%" class="no-border">
            <div class="company-details">
              <h3 class="bapat_heading">BAPAT OPTICS KOTHRUD</h3> <br>
              <%= data?.app_setup?.address %><br>
              Mobile: <%= data?.app_setup?.contact_no %> | Landline: 02025442838<br>
              Email: <%= data?.app_setup?.email %> | GST: 27AKPSZB6861RZA<br>
              Website: <%= data?.app_setup?.website_name %>
            </div>
          </td>
        </tr>
      </table>
    </div>

    <!-- INVOICE TITLE -->
    <h2 class="main_heading">INVOICE</h2>

    <!-- CUSTOMER DETAILS -->
    <table class="no-border padding_zero">
      <tr>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">GST Number :</b>
          27AAGCE1246H1ZS</td>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">Invoice Number :</b>
          <%= data?.order?.invoice_no %>
        </td>
      </tr>
      <tr>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">Customer Name :</b>
          <%= data?.order?.User?.name %> </td>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">Invoice Date :</b>
          <%= new Date(data?.order?.createdAt).toLocaleString() %>
        </td>
      </tr>
      <tr>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">Mobile Number :</b>
          <%= data?.order?.User?.contact_no %>
        </td>
       
         <td class="no-border padding_zero" colspan="2">
  <b class="table_bold_text">Date of Order :</b>
  <%= new Date(data?.order?.createdAt).toLocaleDateString("en-IN") %>
</td>

        </td>
      </tr>
      <tr>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text"> Email ID :</b>
          <%= data?.order?.User?.email %></td>
        
          <td class="no-border padding_zero" colspan="2">
  <b class="table_bold_text">Time of Order :</b>
  <%= new Date(data?.order?.createdAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", second: "2-digit" }) %>
</td>

        </td>
      </tr>

      <tr>
        <td class="no-border padding_zero" colspan="2"><b class="table_bold_text">Address: </b>
          <%= data?.order?.User_Address?.floor %> ,<%= data?.order?.User_Address?.building %>,
          <%= data?.order?.User_Address?.apartment %>,<%= data?.order?.User_Address?.street %>,

          <%= data?.order?.User_Address?.Users_Address_Detail?.Area?.name %> ,
          <%= data?.order?.User_Address?.Users_Address_Detail?.City?.name %>,
          <%= data?.order?.User_Address?.Users_Address_Detail?.State?.name %>,
          <%= data?.order?.User_Address?.Users_Address_Detail?.Country?.name %>,
          <%= data?.order?.User_Address?.Users_Address_Detail?.Pincode?.name %>
        </td>
      </tr>
    </table>

    <!-- PRODUCT DETAILS -->
    <table>
      <tr>
        <th><b>SL NO</b></th>
        <th><b>PRODUCT DETAILS</b></th>
        <th><b>HSN CODE</b></th>
        <th><b>GST %</b></th>
        <th><b>PRICE</b></th>
      </tr>
      <% data?.order?.Product_Order_Details?.forEach((item, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td> <%= item?.Product?.name %> </td>
        <td><%= item?.Product?.lic_no %></td>
        <td><%= item?.Product?.tax_percentage %></td>
        <td class="text-right"><%= parseFloat(item?.total_amount).toFixed(2) %></td>
      </tr>
      <% }); %>
    </table>

    <table class="no-border">
      <tr>
        <td class=" bg_td " rowspan="6">
          <h4><strong>Total Paid :</strong> <strong><%= parseFloat(data?.order?.total_amount).toFixed(2) %></strong></h4>
        </td>
        <td class="bg_td" colspan="2">
          <h2>
            <strong>
              You Save :
              <%= (
                parseFloat(data?.order?.reward_discount || 0) +
                parseFloat(data?.order?.total_coupon_discount || 0) +
                parseFloat(data?.order?.total_offer_discount || 0)
              ).toFixed(2) %>
            </strong>
          </h2>
        </td>
        <td class="no-border padding_zero">
          <table class="margin-top-zero no-border padding_zero">
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder">
                  <p>Total : <%= parseFloat(data?.order?.total_selling_price || 0).toFixed(2) %></p>
                </div>
              </td>
            </tr>
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder">
                  <p> GST Amount : <%= parseFloat(data?.order?.total_tax || 0).toFixed(2) %></p>
                </div>
              </td>
            </tr>
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder">
                  <p>Gross Total :
                    <%= (parseFloat(data?.order?.total_selling_price || 0) + parseFloat(data?.order?.total_tax || 0)).toFixed(2) %>
                  </p>
                </div>
              </td>
            </tr>
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder">
                  <p>Total Discount :
                    <%= (
                      parseFloat(data?.order?.reward_discount || 0) +
                      parseFloat(data?.order?.total_coupon_discount || 0) +
                      parseFloat(data?.order?.total_offer_discount || 0)
                    ).toFixed(2) %>
                  </p>
                </div>
              </td>
            </tr>
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder margin_top">
                  <h4>Net Total Amount</h4>
                </div>
              </td>
            </tr>
            <tr>
              <td class="no-border padding_zero">
                <div class="total_submmary text_holder">
                  <h4>Rs <%= parseFloat(data?.order?.total_amount || 0).toFixed(2) %></h4>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>

    <!--  TITLE -->
    <h3 class="title_txt_two table_bold_text">GST DETAILS</h3>

    <!-- GST DETAILS -->
    <table style="width: 70%;">
      <tr>
        <th>HSN CODE</th>
        <th>GST %</th>
        <th>SALE VALUE</th>
        <th>CGST</th>
        <th>SGST</th>
        <th>Total GST</th>
      </tr>
      <% data?.order?.Product_Order_Details?.forEach((item) => { %>
      <tr>
        <td><%= item?.Product?.lic_no %></td>
        <td><%= item?.Product?.tax_percentage %>%</td>
        <td><%= parseFloat(item?.total_selling_price).toFixed(2) %></td>
        <td><%= (parseFloat(item?.total_tax || 0) / 2).toFixed(2) %></td>
        <td><%= (parseFloat(item?.total_tax || 0) / 2).toFixed(2) %></td>
        <td><%= parseFloat(item?.total_tax || 0).toFixed(2) %></td>
      </tr>
      <% }); %>

      <tr>
        <td colspan="2"><strong>Total</strong></td>
        <td><strong><%= parseFloat(data?.order?.total_selling_price || 0).toFixed(2) %></strong></td>
        <td><strong><%= (parseFloat(data?.order?.total_tax || 0) / 2).toFixed(2) %></strong></td>
        <td><strong><%= (parseFloat(data?.order?.total_tax || 0) / 2).toFixed(2) %></strong></td>
        <td><strong><%= parseFloat(data?.order?.total_tax || 0).toFixed(2) %></strong></td>
      </tr>
    </table>

    <!-- INVOICE TITLE -->
    <h2 class="main_heading">PRESCRIPTION</h2>

    <!-- PRESCRIPTION -->
    <div class="prescription">
      <p><strong class="table_bold_text">Date & Time :</strong> 10-11-2024 19:44:00 </p>
      <p><strong class="table_bold_text"> Patient Name : </strong> EKAYAN BIZSOL (OPC) PRIVATE LIMITED</p>
      <p><strong class="table_bold_text">Doctor / Optometrist Name :</strong> ___________</p>

      <table class="no-border">
        <tr class="no-border">
          <th class="no-border text-center table_bold_text" colspan="6">RIGHT EYE (OD)</th>
          <th class="no-border text-center table_bold_text" colspan="6">LEFT EYE (OS)</th>
        </tr>
        <tr>
          <th></th>
          <th>SPH</th>
          <th>CYL</th>
          <th>AXIS</th>
          <th>PD</th>
          <th>VA</th>
          <th>PRISM</th>
          <th>SPH</th>
          <th>CYL</th>
          <th>AXIS</th>
          <th>PD</th>
          <th>VA</th>
          <th>PRISM</th>
        </tr>
        <tr>
          <th>DV</th>
          <td>-</td>
          <td>-1.50</td>
          <td>-</td>
          <td>170</td>
          <td>-</td>
          <td>-</td>
          <td>-1.00</td>
          <td>-</td>
          <td>180</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
        </tr>
        <tr>
          <th>NV</th>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
        </tr>
        <tr>
          <th>ADD</th>
          <td colspan="6">-</td>
          <td colspan="6">-</td>
        </tr>
        <tr>
          <th>IPD</th>
          <td colspan="12">-</td>
        </tr>
      </table>

      <div class="checkbox">
        <input type="checkbox" checked> Distance Wear
        <input type="checkbox" checked> Single Vision
      </div>

      <p class="text-center"><b>TIMING: 10.30 AM TO 9.00 PM. MONDAY to SUNDAY</b></p>
    </div>

  </div>
</body>

</html>
