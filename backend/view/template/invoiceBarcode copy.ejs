<!DOCTYPE html>
<html>

<head>
    <title>Bapat Optics Barcode</title>
  <base href="<%= data.base %>" />
    <style>
        .page-break {
            page-break-before: always !important;
        }

        .design2 {
            padding-top: 40px !important;
        }

        @media print {
            body {
                margin: 0;
            }

            .design1,
            .design2 {
                page-break-after: always !important;
            }

            .page-break {
                display: block !important;
                height: 0 !important;
            }
        }
    </style>
</head>

<body style="
      font-family: Arial, sans-serif;
      font-size: 12px;
      padding: 0;
      width: 85mm;
     
      margin: 0px auto;
      margin-left: 40px;
    ">

    <div class="design1" style="">
<% data?.data?.forEach((item, index) => { %>
        <div class="batdiv" style="display: flex;align-items: center;">
             
            <div class="leftbd"
                style="  padding: 0px; width: 5.5cm ; display: flex;align-items: center; padding: 1px;">
                <div class="contdiv" style="width: 2.7cm;">
                    <p style=" color: #000;margin: 1px; font-weight: 600;font-size: 10px;     text-transform: uppercase;"><%= item?.Product?.Brand?.name || '' %>  </p>
                    <p style="color: #000;margin: 1px; font-weight: 600;font-size: 11px;">Rs.<%= item?.Product?.mrp || '' %></p>
                    <p style="font-weight: 600;font-size:11px; color: #000; margin: 2px;     text-transform: uppercase;"><%= item?.Product?.model_no || '' %></p>
                </div>
                <div class="barcodediv" style="width: 2.7cm;">
                    <p style="font-size: 10px; color: #000;margin: 1px;font-weight: 600; text-align: left;     text-transform: uppercase;" >BAPAT OPTICS</p>
                    <img style="width:80%; height: 10px; text-align: center; " src="<%= item?.barcode %>" />
                     <p style="font-size: 10px; color: #000;font-weight: 100; text-align: left; margin: 1px;     text-transform: uppercase;" ><%= item?.barcode_no || '' %></p>

                    <!-- <img style="width:100%; height: 30px;" src="./assets/barcode.png" /> -->
                </div>
            </div>
              <!-- <div class="righttbd"
                style="border: 1px solid #000;border-left: 0px; padding: 2px; width: 30mm;height: 2mm;">
            </div> -->
         
          
        </div>
           <% }); %>

    </div>

    <!-- PAGE BREAK -->
    <!-- <div class="page-break"></div> -->

    <!-- DESIGN 2 -->

    <!-- <div class="design2" style="
        min-height: 100%;
        margin-top: 15px;
        margin-bottom: 12px;
        border: 1px solid #000;
        padding: 10px;
      ">



        <br />

    </div> -->

</body>

</html>